<!-- JAVASCRIPT -->
<script>
  function submitBooking(event) {
    event.preventDefault();
    const name = document.getElementById('guestName').value;
    const contact = document.getElementById('guestContact').value;
    const date = document.getElementById('guestDate').value;
    const count = document.getElementById('guestCount').value;
    const pkg = document.getElementById('guestPackage').value;

    const message = `*JOZANI FOREST BOOKING - UNP TOURS*%0A%0A` +
      `*Name:* ${encodeURIComponent(name)}%0A` +
      `*Contact:* ${encodeURIComponent(contact)}%0A` +
      `*Date:* ${encodeURIComponent(date)}%0A` +
      `*Guests:* ${encodeURIComponent(count)}%0A` +
      `*Package:* ${encodeURIComponent(pkg)}`;

    window.open('https://wa.me/255655728982?text=' + message, '_blank');
  }
</script>

