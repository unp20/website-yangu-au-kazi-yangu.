<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 500 500" width="100%" height="100%">
  <defs>
    <!-- 1. Gradient ya Dhahabu (Gold) -->
    <linearGradient id="goldGradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#F9E79F" />
      <stop offset="30%" stop-color="#D4AF37" />
      <stop offset="60%" stop-color="#B8860B" />
      <stop offset="100%" stop-color="#F7DC6F" />
    </linearGradient>

    <!-- 2. Gradient ya Kijani (Green) kwa ajili ya background -->
    <radialGradient id="bgGradient" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#1E5631" />
      <stop offset="70%" stop-color="#0B2B1A" />
      <stop offset="100%" stop-color="#05140C" />
    </radialGradient>

    <!-- 3. Filter ya Mwanga (Glow) kwenye Jani -->
    <filter id="glow" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="6" result="blur" />
      <feComposite in="SourceGraphic" in2="blur" operator="over" />
    </filter>

    <!-- 4. Filter ya Kivuli (Shadow) kwa maandishi -->
    <filter id="shadow" x="-10%" y="-10%" width="120%" height="120%">
      <feDropShadow dx="2" dy="2" stdDeviation="3" flood-color="#000" flood-opacity="0.5"/>
    </filter>
  </defs>

  <!-- Background ya Kijani (Ovali) -->
  <circle cx="250" cy="250" r="230" fill="url(#bgGradient)" stroke="url(#goldGradient)" stroke-width="6" />
  
  <!-- Mzunguko wa Nje wa Dhahabu (Outer Ring) -->
  <circle cx="250" cy="250" r="210" fill="none" stroke="url(#goldGradient)" stroke-width="3" />
  
  <!-- Mstari wa Kati wa Dhahabu (Inner Ring) -->
  <circle cx="250" cy="250" r="190" fill="none" stroke="url(#goldGradient)" stroke-width="1.5" stroke-dasharray="10 5" />

  <!-- ========================================== -->
  <!-- JANI LA MGOMBA (Banana Leaf) - Kwa Mtindo wa Vector -->
  <!-- ========================================== -->
  <g transform="translate(250, 230) rotate(-15)">
    <!-- Shina kuu la Jani (Stem) -->
    <path d="M -100 80 Q -20 0 60 -80 Q 70 -90 80 -85" fill="none" stroke="url(#goldGradient)" stroke-width="8" stroke-linecap="round" filter="url(#glow)"/>
    
    <!-- Majani (Leaflets) - Upande wa Kushoto -->
    <path d="M -80 60 Q -60 20 -40 -10 Q -30 -20 -20 -25" fill="none" stroke="url(#goldGradient)" stroke-width="5" stroke-linecap="round" filter="url(#glow)"/>
    <path d="M -50 30 Q -30 0 -10 -30 Q 0 -40 10 -45" fill="none" stroke="url(#goldGradient)" stroke-width="5" stroke-linecap="round" filter="url(#glow)"/>
    <path d="M -20 0 Q 0 -30 20 -50 Q 30 -60 40 -65" fill="none" stroke="url(#goldGradient)" stroke-width="5" stroke-linecap="round" filter="url(#glow)"/>
    
    <!-- Majani (Leaflets) - Upande wa Kulia -->
    <path d="M -60 40 Q -20 30 20 20 Q 40 15 60 10" fill="none" stroke="url(#goldGradient)" stroke-width="5" stroke-linecap="round" filter="url(#glow)"/>
    <path d="M -30 10 Q 10 0 50 -10 Q 70 -15 90 -20" fill="none" stroke="url(#goldGradient)" stroke-width="5" stroke-linecap="round" filter="url(#glow)"/>
    <path d="M 0 -20 Q 40 -30 80 -40 Q 100 -45 110 -50" fill="none" stroke="url(#goldGradient)" stroke-width="5" stroke-linecap="round" filter="url(#glow)"/>
    
    <!-- Kilele cha Jani (Top Tip) -->
    <path d="M 80 -85 Q 100 -100 110 -120 Q 100 -110 80 -100" fill="url(#goldGradient)" filter="url(#glow)"/>
  </g>

  <!-- ========================================== -->
  <!-- WIMBI LA DHAHABU (Gold Swirl) -->
  <!-- ========================================== -->
  <path d="M 150 330 Q 250 380 350 300 Q 380 270 370 240 Q 360 220 340 230 Q 320 240 330 260 Q 340 280 300 290 Q 250 300 180 320" 
        fill="none" stroke="url(#goldGradient)" stroke-width="6" stroke-linecap="round" filter="url(#glow)"/>
  
  <!-- Mzunguko mdogo wa wimbi -->
  <path d="M 320 260 Q 350 250 360 270 Q 370 290 350 300" 
        fill="none" stroke="url(#goldGradient)" stroke-width="4" stroke-linecap="round"/>

  <!-- ========================================== -->
  <!-- MAANDISHI (Text) -->
  <!-- ========================================== -->
  
  <!-- UNP (Kubwa) -->
  <text x="250" y="380" font-family="'Times New Roman', serif" font-size="70" font-weight="bold" fill="url(#goldGradient)" text-anchor="middle" filter="url(#shadow)" letter-spacing="5">
    UNP
  </text>

  <!-- UNIQUE NATURE PARADISE (Ndogo) - Imezungukwa -->
  <path id="textPath" d="M 100 400 A 150 150 0 0 0 400 400" fill="none" />
  <text font-family="'Arial', sans-serif" font-size="16" font-weight="bold" fill="url(#goldGradient)" text-anchor="middle" letter-spacing="3">
    <textPath href="#textPath" startOffset="50%">
      UNIQUE NATURE PARADISE
    </textPath>
  </text>
</svg>
